{
  "name": "@elastic.io/component-commons-library",
  "version": "4.0.1",
  "description": "Library for most common component development cases",
  "author": {
    "name": "elastic.io GmbH",
    "email": "info@elastic.io",
    "url": "http://elastic.io"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "elasticio",
    "ipaas",
    "elasticio-component"
  ],
  "scripts": {
    "lint": "eslint --ext .ts --quiet --fix",
    "pretest": "rm -rf dist && eslint --ext .ts --quiet --fix && find src spec spec-integration -name \"*.js\" -type f -delete",
    "posttest": "tsc",
    "test": "mocha --require ts-node/register \"spec/**/*spec.ts\" --timeout 50000",
    "integration-test": "npm run pretest && nyc mocha --require ts-node/register \"spec-integration/**/*spec.ts\" --timeout 500000",
    "build": "rm -rf dist && tsc"
  },
  "dependencies": {
    "@elastic.io/jsonata-moment": "^1.1.6",
    "@elastic.io/maester-client": "^6.0.2",
    "axios": "^1.19.0",
    "bunyan": "^1.8.15",
    "bunyan-format": "^0.2.1",
    "remove-leading-slash": "^1.0.1",
    "remove-trailing-slash": "^0.1.1"
  },
  "overrides": {
    "jsonata": "1.8.9"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^8.0.2",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "dotenv": "^16.6.1",
    "nock": "^13.5.6",
    "tslint": "^5.20.1",
    "tslint-config-airbnb": "^5.11.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "mocha": "^10.8.2",
    "nyc": "^17.1.0",
    "sinon": "^18.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "repository": "elasticio/component-commons-library",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  }
}